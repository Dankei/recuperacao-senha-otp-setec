# Porta em que o servidor Express vai escutar
PORT=3000

# MariaDB (aula local: usuário root sem senha)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cruso_setec

# Frase secreta usada para assinar o cookie de sessão.
# Em produção, troque por um valor longo e aleatório.
SESSION_SECRET=troque-esta-chave-por-uma-frase-secreta

# Conta Gmail que vai enviar o código OTP.
# Deixe em branco para a aula funcionar sem e-mail:
# o código será impresso no terminal.
EMAIL_USER=

# App Password do Google (NÃO use a senha normal da conta).
# Veja no README como gerar essa senha de 16 caracteres.
EMAIL_PASSWORD=
